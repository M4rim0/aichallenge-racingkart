{
  "name": "wgc-race-manager",
  "version": "0.1.0",
  "private": true,
  "description": "WGC race management and strategy support (offline, Windows)",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/fetch-electron-sqlite.mjs",
    "setup:native": "node scripts/fetch-electron-sqlite.mjs --force",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "33.4.11",
    "electron-vite": "6.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
